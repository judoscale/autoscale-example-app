<div
  class="prose max-w-none"
  x-data='queuePoller(<%= new_job_path(format: :json).to_json %>, <%= @queues.to_json %>)'
>
  <p>
    Use this form to enqueue jobs and trigger worker autoscaling.
    Queue metrics update automatically while polling is enabled.
  </p>

  <div class="not-prose mt-8">
    <div>
      <h2 class="text-sm font-semibold text-gray-900">
        Queues
        <span class="font-normal text-gray-500">
          (auto-refresh
          <a href="#" class="font-medium text-indigo-600 hover:text-indigo-500" @click.prevent="toggle()" x-text="polling ? 'on' : 'off'"></a>)
        </span>
      </h2>
      <p class="mt-1 text-sm text-gray-500">Current Sidekiq queue depth and latency.</p>
    </div>

    <div class="mt-4 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pl-6">Queue</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Pending</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">Busy</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pr-6">Latency</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-200">
          <template x-if="queues.length === 0">
            <tr>
              <td colspan="4" class="px-4 py-4 text-sm italic text-gray-500 sm:px-6">
                There are no Sidekiq queues yet. Enqueue some jobs to create a queue.
              </td>
            </tr>
          </template>

          <template x-for="queue in queues" :key="queue.name">
            <tr>
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-left text-sm font-normal text-gray-700 sm:pl-6" x-text="queue.name"></td>
              <td class="whitespace-nowrap px-4 py-4 text-right text-sm font-medium tabular-nums text-gray-900" x-text="queue.size"></td>
              <td class="whitespace-nowrap px-4 py-4 text-right text-sm font-medium tabular-nums text-gray-900" x-text="queue.busy"></td>
              <td class="whitespace-nowrap px-4 py-4 text-right text-sm font-medium tabular-nums text-gray-900 sm:pr-6" x-text="`${queue.latency}s`"></td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= form_with model: @manager, url: jobs_path do |form| %>
  <div class="border-t pt-12 space-y-10">
    <%= form.field do %>
      <%= form.label "How many jobs do you want to enqueue?" %>

      <% jobs_opts = { 1 => "1 job", 5 => "5 jobs", 10 => "10 jobs", 50 => "50 jobs" } %>
      <%= form.radio_buttons :jobs, jobs_opts %>
    <% end %>

    <%= form.field do %>
      <%= form.label "How long do you want the job(s) to take?" %>

      <% latency_opts = { 1000 => "1 sec", 5000 => "5 sec", 10_000 => "10 sec", 25_000 => "25 sec" } %>
      <%= form.radio_buttons :latency, latency_opts %>
    <% end %>

    <%= form.field do %>
      <%= form.label "Which queue?" %>
      <%= form.radio_buttons :queue, %w[default urgent] %>
    <% end %>

    <%= form.button_row "Enqueue job(s)" %>
  </div>
<% end %>
