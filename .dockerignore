# See https://docs.docker.com/engine/reference/builder/#dockerignore-file

/.git/
/.github/
/.agents/
/.amp/
/.bundle
/.env*

# Logs and temp files, keeping the directories
/log/*
!/log/.keep
/tmp/*

# Built assets are generated during the image build
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

/test/
/.dockerignore
/Dockerfile
